{
  "name": "timerhub",
  "productName": "TimerHub",
  "version": "1.0.0",
  "description": "Timers de quêtes journalières, hebdomadaires et personnalisés",
  "main": "main.js",
  "author": "Ruby",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "serve": "node scripts/serve-web.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.timerhub.app",
    "productName": "TimerHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "web/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Distopiary",
        "repo": "TimerHub",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TimerHub"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
